# ====================================================
# CONFIGURACIÓN DEL BOT DE TELEGRAM (PYROGRAM)
# ====================================================
# Obtén estos datos en https://my.telegram.org/apps
API_ID=12345678
API_HASH=tu_api_hash_aqui

# Obtén tu token con @BotFather en Telegram
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# ID de Telegram del Administrador / Owner (para acceso al panel admin)
ADMIN_IDS=8670239783

# ID del Grupo Privado de Auditoría / Canal DB (ejemplo: -1001234567890)
# Agrega el bot como Administrador a este grupo para registrar compras, depósitos y alertas
LOG_GROUP_ID=-1001234567890

# ====================================================
# API DE PROVEEDOR (BUNAISTORE)
# ====================================================
BUNAI_API_KEY=Shop::_3a2klpvDK9_SH2FY46suaM5pb8
BUNAI_BASE_URL=https://api.bunaistore.shop/v1

# ====================================================
# CONFIGURACIÓN BLOCKCHAIN (USDT BEP-20 / BSC)
# ====================================================
# Billetera personal de BNB Smart Chain (BEP-20) donde recibirás todos los pagos
ADMIN_WALLET_BSC=0x540532E72e08fdaAB525f5D692ea97C40CCE5d24

# RPC de BNB Smart Chain (puedes usar el público oficial o fallbacks)
BSC_RPC_URL=https://bsc-dataseed.binance.org/
BSC_RPC_FALLBACKS_RAW=https://1rpc.io/bnb,https://rpc.ankr.com/bsc,https://bsc.publicnode.com,https://bsc-dataseed1.defibit.io

# Contrato oficial de USDT en Binance Smart Chain (No cambiar)
USDT_CONTRACT_ADDRESS=0x55d398326f99059fF775485246999027B3197955

# Confirmaciones mínimas de bloque requeridas
MIN_BLOCK_CONFIRMATIONS=3

# Ruta de la imagen oficial del código QR de la billetera
QR_IMAGE_PATH=assets/TrustWalletQR.jpg

# ====================================================
# PARÁMETROS DEL SERVICIO Y MÁRGENES
# ====================================================
# Margen de ganancia porcentual por defecto sobre el costo del proveedor (ej: 30.0 = 30%)
DEFAULT_MARGIN_PERCENT=30.0

# Depósito mínimo permitido en USDT
MIN_DEPOSIT_USDT=2.0

# Porcentaje de comisión para el sistema de afiliados/referidos (ej: 5.0 = 5%)
REFERRAL_COMMISSION_PERCENT=5.0

# Frecuencia en horas para el envío automático de copias de seguridad de la base de datos a Telegram
AUTO_BACKUP_HOURS=24

# ====================================================
# BASE DE DATOS (POSTGRESQL - DOKPLOY / DOCKER COMPOSE)
# ====================================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_pass@db:5432/services_bot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass
POSTGRES_DB=services_bot
